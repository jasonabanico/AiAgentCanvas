<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Scoped to this repository. Every package it needs is on nuget.org, so the
    machine-level feed list is cleared here. Source mapping is what Central
    Package Management wants (NU1507) and it closes the dependency-confusion
    path where a private feed can shadow a public package name.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
