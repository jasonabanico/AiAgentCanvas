<Project>

  <!--
    Central Package Management. Versions live here only; csproj files carry bare
    PackageReference entries. Before this, Microsoft.Extensions.AI's version was
    written out 24 times and Options.ConfigurationExtensions had drifted to two
    different versions across projects.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Microsoft Agent Framework">
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.22.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Abstractions" Version="1.22.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Harness" Version="1.22.0" />
    <PackageVersion Include="Microsoft.Agents.AI.OpenAI" Version="1.22.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows" Version="1.22.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows.Declarative" Version="1.22.0" />
    <PackageVersion Include="Microsoft.Agents.AI.A2A" Version="1.22.0-preview.260918.1" />
    <PackageVersion Include="Microsoft.Agents.AI.DevUI" Version="1.22.0-preview.260918.1" />
    <PackageVersion Include="Microsoft.Agents.AI.Hosting.A2A.AspNetCore" Version="1.22.0-preview.260918.1" />
    <PackageVersion Include="Microsoft.Agents.AI.Hosting.AGUI.AspNetCore" Version="1.22.0-preview.260918.1" />
    <PackageVersion Include="Microsoft.Agents.AI.Purview" Version="1.22.0-rc1" />
  </ItemGroup>

  <ItemGroup Label="Microsoft.Extensions.AI">
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.VectorData.Abstractions" Version="10.10.0" />
  </ItemGroup>

  <ItemGroup Label="Evaluation">
    <PackageVersion Include="Microsoft.Extensions.AI.Evaluation" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Evaluation.Quality" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Evaluation.Reporting" Version="10.10.0" />
  </ItemGroup>

  <ItemGroup Label="Microsoft.Extensions">
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.7.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Providers and data">
    <PackageVersion Include="Azure.AI.OpenAI" Version="2.9.0-beta.1" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="OpenAI" Version="2.13.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageVersion Include="ModelContextProtocol" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup Label="Tokenizers">
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" Version="2.0.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup Label="Transitive pins">
    <!--
      Pulled in transitively at vulnerable versions. Transitive pinning lifts them
      without waiting for the packages that reference them to update.
      Microsoft.Bcl.Memory 9.0.4  -> GHSA-73j8-2gch-69rq
      SQLitePCLRaw 2.1.11         -> GHSA-2m69-gcr7-jv3q
    -->
    <PackageVersion Include="Microsoft.Bcl.Memory" Version="10.0.12" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup Label="Authentication">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Governance and telemetry">
    <PackageVersion Include="Microsoft.AgentGovernance" Version="4.0.0" />
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.5.0" />
  </ItemGroup>

  <ItemGroup Label="Capabilities">
    <PackageVersion Include="Microsoft.Playwright" Version="1.52.0" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
