<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Platform\AiAgentCanvas.Abstractions\AiAgentCanvas.Abstractions.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Needed so AssemblyDependencyResolver (in the Host's PluginLoadContext)
         can resolve this plugin's private dependencies at load time. -->
    <GenerateDependencyFile>true</GenerateDependencyFile>
  </PropertyGroup>

  <!--
    Not referenced by the Host at compile time. This project is loaded at
    runtime via AssemblyLoadContext (see ServiceModuleExtensions.AddServiceModules).
    This target just copies the build output into the Host's plugins folder so
    it's there to load.
  -->
  <Target Name="CopyToHostPluginsFolder" AfterTargets="Build">
    <ItemGroup>
      <PluginOutputFiles Include="$(TargetDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginOutputFiles)"
          DestinationFolder="$(HostPluginsDir)$(MSBuildProjectName)\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
