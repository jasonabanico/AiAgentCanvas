{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Security": {
    "PolicyPath": "governance-policy.yaml",
    "RateLimitPerMinute": 30,
    "ApprovalRequiredTools": [
      "system_write_file",
      "system_run_script",
      "connect_mcp_server",
      "schedule_task"
    ]
  },
  "Authentication": {
    "Enabled": false,
    "Schemes": [],
    "AllowAnonymous": [
      "health"
    ],
    "AllowedOrigins": [],
    "ApiKey": {
      "HeaderName": "X-API-Key",
      "Keys": [],
      "PrincipalName": "api-key-client"
    },
    "JwtBearer": {
      "Authority": "",
      "Audience": "",
      "RequireHttpsMetadata": true,
      "RequiredScopes": []
    }
  },
  "Agent": {
    "TokenizerModel": "gpt-4o",
    "ContextBudget": {
      "Enabled": true,
      "MaxContextTokens": 128000,
      "ReservedOutputTokens": 16384,
      "InstructionsFraction": 0.3,
      "ToolsFraction": 0.1,
      "HistoryFraction": 0.5,
      "KeepRecentMessages": 8,
      "SummarizeDroppedHistory": true,
      "SummaryMaxTokens": 512
    },
    "LoopGuard": {
      "Enabled": true,
      "MaxToolRounds": 25,
      "MaxRunTokens": 250000,
      "RepeatWarningThreshold": 2,
      "RepeatTerminationThreshold": 4,
      "StagnationWindow": 3
    },
    "Pricing": {
      "Enabled": true,
      "Currency": "USD",
      "DefaultModel": "gpt-4o",
      "Models": {
        "gpt-4o": {
          "InputPer1M": 2.5,
          "OutputPer1M": 10.0
        },
        "gpt-4o-mini": {
          "InputPer1M": 0.15,
          "OutputPer1M": 0.6
        }
      }
    },
    "Reflection": {
      "Enabled": false,
      "ReflectionInterval": 3
    },
    "ModelRouter": {
      "Enabled": false,
      "ComplexityThresholdTokens": 200
    },
    "Scheduler": {
      "TickSeconds": 30,
      "MaxConcurrentTasks": 2,
      "TaskTimeoutMinutes": 15
    },
    "EventTriggers": {
      "PollSeconds": 30,
      "QueueCapacity": 256,
      "RunTimeoutMinutes": 10
    }
  },
  "SystemTools": {
    "AllowedPaths": [],
    "AllowedCommands": [
      "dotnet",
      "git",
      "npm",
      "node"
    ],
    "MaxFileSizeBytes": 1048576,
    "ScriptTimeoutSeconds": 30
  },
  "ChatHistory": {
    "ConnectionString": "Data Source=chathistory.db",
    "MaxMessages": 200
  },
  "Provider": "AzureAIFoundry",
  "AIFoundry": {
    "Endpoint": "https://YOUR-RESOURCE.openai.azure.com",
    "Key": "",
    "DeploymentName": "gpt-4o",
    "EmbeddingDeploymentName": "",
    "EconomyDeploymentName": "",
    "JudgeDeploymentName": "",
    "UseAzureCredential": false
  },
  "Databricks": {
    "WorkspaceUrl": "https://YOUR-WORKSPACE.cloud.databricks.com",
    "PersonalAccessToken": "",
    "ModelName": "databricks-dbrx-instruct",
    "EmbeddingModelName": "",
    "EconomyModelName": "",
    "JudgeModelName": ""
  },
  "DatabricksVectorSearch": {
    "WorkspaceUrl": "https://YOUR-WORKSPACE.cloud.databricks.com",
    "PersonalAccessToken": "",
    "IndexName": "",
    "Columns": [
      "id",
      "text"
    ],
    "NumResults": 5
  },
  "Snowflake": {
    "AccountUrl": "https://YOUR-ACCOUNT.snowflakecomputing.com",
    "PersonalAccessToken": "",
    "ModelName": "claude-sonnet-4-5",
    "EmbeddingModelName": "",
    "EconomyModelName": "",
    "JudgeModelName": "",
    "CortexSearch": {
      "AccountUrl": "https://YOUR-ACCOUNT.snowflakecomputing.com",
      "PersonalAccessToken": "",
      "Database": "",
      "Schema": "",
      "ServiceName": "",
      "Columns": [
        "chunk"
      ],
      "Limit": 5
    }
  },
  "VectorStore": {
    "ConnectionString": "Data Source=vectorstore.db"
  }
}
